NODE_ENV=development
PORT=5000

# Required for the API and seed script.
MONGODB_URI=mongodb://127.0.0.1:27017/certchain
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins, or * for local development.
CORS_ORIGIN=http://localhost:8080

# Optional: enable the deployed CertificateRegistry instead of simulation.
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
ADMIN_WALLET_PRIVATE_KEY=